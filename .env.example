# Email Configuration for ClearRecon Scraper
# Copy this file to .env and fill in your email credentials

# SMTP Server Settings
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Email Account (Create a dedicated Gmail account for this app)
SENDER_EMAIL=your-app-email@gmail.com
SENDER_PASSWORD=your-app-password

# Instructions:
# 1. Create a new Gmail account specifically for this application
# 2. Enable 2-factor authentication on the account
# 3. Generate an "App Password" for this application
# 4. Copy this file to .env and enter your credentials
# 5. Never commit the .env file to version control
